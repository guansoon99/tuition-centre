APP_NAME="Tuition Centre LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.tld

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuition
DB_USERNAME=tuition
DB_PASSWORD=

# Cache/session/queue stack — deliberately no Redis at launch.
#
# `file` cache on a single app server is <2ms per read on SSD and needs
# zero extra service to run. Switch to redis only when you actually add
# one of these:
#   - a second app server (need shared cache/session)
#   - background jobs (video encode, batch email, exports)
#   - real-time features (live announcements, pub/sub)
#
# Sessions are `file` for the same reason the cache is: every authenticated
# request reads and writes the session, and on one app server that's two small
# file ops (~0.2ms, OS page-cached) versus two MySQL round-trips (~0.6-1ms)
# plus write churn in the same database holding your real data. Faster, and it
# keeps session traffic off MySQL entirely.
#
# If a second app server ever appears, cache AND sessions both have to move to
# a shared store at the same time — they have the same single-box limitation.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
# One R2 bucket, never given public access, holding everything a user
# uploaded: material PDFs, student submissions, lesson media, announcement
# images. Each is reached through a controller that authorises the caller and
# then signs a short-lived URL.
FILESYSTEM_DISK=r2

# Branding — site logo, banner slides, course banners — stays on this server's
# own disk, served by nginx through the storage:link symlink.
#
# These render before login, so they cannot be gated. R2 has no per-object
# visibility: making them public there would mean either a second bucket, or
# giving THIS bucket a public domain, which would expose every student
# submission in it. The local disk avoids that question entirely.
#
# The trade-off is that they do not survive a server rebuild. They are a logo
# and a few banners, so re-uploading is a minor cost against the risk.
#
# Switch to a dedicated public bucket (an `r2_public` disk exists for it) if
# you ever add a second app server, where local files stop being shared.
UPLOADS_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=10080
# Marks the session cookie Secure so it is never sent over plain HTTP.
# config/session.php reads env('SESSION_SECURE_COOKIE') with no fallback, so
# leaving this unset means the cookie ships without the flag.
SESSION_SECURE_COOKIE=true

# Cloudflare R2. Zero egress fees, so files stream from Cloudflare rather than
# eating this server's metered transfer. Scope the token Object Read & Write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=tuition-prod

# ⚠ Never enable public access on this bucket — no custom domain, no r2.dev
# subdomain. R2 exposes a bucket all-or-nothing, so one domain here publishes
# every student submission it holds. Verify with `php artisan storage:check`.

# Cloudflare in front. Trust the proxy so $request->ip() returns the real client IP.
TRUSTED_PROXIES=*

# Mail can stay off until needed. The skeleton has no email features.
MAIL_MAILER=log
