APP_NAME="Tuition Centre LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.tld

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuition
DB_USERNAME=tuition
DB_PASSWORD=

# Cache/session/queue stack — deliberately no Redis at launch.
#
# `file` cache on a single app server is <2ms per read on SSD and needs
# zero extra service to run. Switch to redis only when you actually add
# one of these:
#   - a second app server (need shared cache/session)
#   - background jobs (video encode, batch email, exports)
#   - real-time features (live announcements, pub/sub)
#
# Sessions are `file` for the same reason the cache is: every authenticated
# request reads and writes the session, and on one app server that's two small
# file ops (~0.2ms, OS page-cached) versus two MySQL round-trips (~0.6-1ms)
# plus write churn in the same database holding your real data. Faster, and it
# keeps session traffic off MySQL entirely.
#
# If a second app server ever appears, cache AND sessions both have to move to
# a shared store at the same time — they have the same single-box limitation.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Two disks, two buckets, on purpose. FILESYSTEM_DISK is the private one
# (material PDFs, student submissions); UPLOADS_DISK is the public one
# (banners, announcement images, inline images, videos). They must NOT be the
# same — the public bucket gets a world-readable custom domain, and pointing
# that at the bucket holding submissions would publish student work.
FILESYSTEM_DISK=r2
UPLOADS_DISK=r2_public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=10080

# Cloudflare R2 for user uploads (PDFs, videos, images). Zero egress fees
# so videos stream from Cloudflare's edge instead of eating VPS bandwidth.
# One API token can reach both buckets, so the key/secret are shared.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# PRIVATE bucket — material PDFs and student submissions. Stays private
# forever; served only via signed URLs. Never give this one a custom domain.
R2_BUCKET=tuition-prod

# PUBLIC bucket — banners, announcement images, inline images, videos.
R2_PUBLIC_BUCKET=tuition-public

# The public bucket's custom domain. REQUIRED: without it the S3 driver builds
# URLs from the API endpoint, which needs SigV4 auth, so every image 403s
# silently. Verify with `php artisan storage:check`.
R2_PUBLIC_URL=https://cdn.your-domain.tld

# Cloudflare in front. Trust the proxy so $request->ip() returns the real client IP.
TRUSTED_PROXIES=*

# Mail can stay off until needed. The skeleton has no email features.
MAIL_MAILER=log
