/.phpunit.cache
/.phpunit.result.cache
/database/*.sqlite
/database/*.sqlite-journal
/storage/app/exports
/node_modules
/docs/node_modules
# NOTE: /public/build is deliberately NOT ignored. The server has no Node
# installed, so deploys are a plain `git reset --hard` — the compiled CSS/JS
# has to travel with the code. Run `npm run build` before committing any
# template change that introduces a new Tailwind class.
# /public/hot must stay ignored: it's the marker `npm run dev` writes, and if
# it ever reached the server every page would try to load assets from a dev
# server that isn't running.
/public/hot
/public/storage

# User-uploaded media that ended up in public/images/ (StoredFile puts them
# on the `public` disk which is really storage/app/public/, but a few
# manual uploads landed here). Ignore all video files and any GUID-braced
# filename; the two intentional static assets are already tracked.
/public/images/*.mp4
/public/images/*.mov
/public/images/*.webm
/public/images/{*
/storage/*.key
/vendor
# Every .env variant, however it is suffixed. The old list named `.env`,
# `.env.backup` and `.env.production` one by one, which meant a file like
# `.env-r2` — real R2 credentials, and one of those exists on the staging
# box — matched none of them and would have gone up with a `git add -A`.
# The two examples below are the only ones meant to be tracked.
.env*
!.env.example
!.env.production.example
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
